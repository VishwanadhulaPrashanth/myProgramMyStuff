  package demo;

//Find First Occurence Of a Character In a String ?

class Demo {
	public static void main(String[] args) {
		String str = "ababcdcef";	
		char[] arr = str.toCharArray();
		
		int len = arr.length;
		
		for(int i=0;i<len;i++)
		{
			boolean flag = true;
			for(int j=0;j<len;j++)
			{
				if(arr[i]==arr[j]&&(i!=j))
				{
					flag=false;
					break;
				}
			}
			if(flag)
			{
				System.out.println(arr[i]);
				break;
			}
		}

	}
}

