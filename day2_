  #Program 3: Print Names In Sorted Order ?

    package demo;

import java.util.Arrays;
import java.util.HashSet;
import java.util.stream.IntStream;

// Print Alternative Elements In An Array
class Demo
{
	public static void main(String[] args) {
		String[] arr= {"Banana","Apple","Graphes"};
		int len = arr.length;
		
		String temp;
		for(int i=0;i<len;i++)
		{
			for(int j=i+1;j<len;j++)
			{
				if(arr[i].compareTo(arr[j])>0)
				{
					temp=arr[i];
					arr[i]=arr[j];
					arr[j]=temp;
				}
			}
		}
		
		for (String newArr : arr) {
			System.out.print(newArr+" ");
		}
	}
	
}

