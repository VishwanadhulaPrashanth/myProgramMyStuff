#Program 1: Find Longest SubString Without Repeating ?
  package demo;

import java.util.HashSet;

//Finding Longest Substring Without Repeatation
class Demo
{
	public static void main(String[] args) {
		
		String str = "abcdab";
		int len = str.length();
		
		HashSet<Character> hs = new HashSet<>();
		String overAllHighest="";
		String currentHighest="";
		System.out.println(Logic(str,hs,len,overAllHighest,currentHighest));
	}

	private static String Logic(String str, HashSet<Character> hs, int len, String overAllHighest,	String currentHighest) {
		
		for(int i=0;i<len;i++)
		{
			char ch = str.charAt(i);
			
			if(hs.contains(ch))
			{
				hs.clear();
				currentHighest="";
			}
			currentHighest+=ch;
			hs.add(ch);
			
			if(currentHighest.length()>overAllHighest.length())
			{
				overAllHighest=currentHighest;
			}
		}
		
		return overAllHighest;
	}
	
}
