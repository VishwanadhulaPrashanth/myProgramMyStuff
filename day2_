package demo;

import java.util.Arrays;

//String Equality Checking (Manual) ?
class Demo {
	public static void main(String[] args) {
		String s1 = "listen";
		String s2 = "listen";

		int s1Len = s1.length();
		int s2Len = s2.length();

		boolean check = StringEqualityCheck(s1, s2, s2Len, s1Len);
		
		if(check)
			System.out.println("Equal");
		else
		System.out.println("Not Equal");
	}

	private static boolean StringEqualityCheck(String s1, String s2, int s2Len, int s1Len) {
		
		boolean isEqual=true;
		
		char[] arr1 = s1.toCharArray();
		char[] arr2 = s2.toCharArray();
		
		if(s1Len!=s2Len)
		{
			isEqual= false;
		}
		else
		{
			for(int i=0;i<s1Len;i++)
			{
				if(arr1[i]!=arr2[i])
				{
					isEqual= false;
				}
			}
		}
		return isEqual;

	}
}
