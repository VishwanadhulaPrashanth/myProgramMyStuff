#Program 5 : Reverse Characters In a Word In a String ?
class Demo
{
	public static void main(String[] args) {
		String str = "Hello World Java";
		String[] arr = str.split(" "); //Hello World Java
		
		String rev="";
		
		
		for(int i=0;i<arr.length;i++) { 
			
			String newStr = arr[i]; //Hello
			String strRev="";
			for(int j=newStr.length()-1;j>=0;j--)
			{
				
				char ch = newStr.charAt(j);
				strRev+=ch;
			}
			rev+=strRev+" ";
		}
		System.out.print(rev+" ");
	}
}
